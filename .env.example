APP_ENV=development
DATABASE_URL=postgresql+psycopg://flextrust:flextrust@postgres:5432/flextrust

# Local development/test only. Non-development environments fail closed unless
# AUTH_MODE=oidc and the trust configuration below is supplied.
AUTH_MODE=development_headers
OIDC_ISSUER=https://identity.example.invalid/
OIDC_AUDIENCE=energy-flex-api
OIDC_ROLE_CLAIM=energy_flex_role
OIDC_SUBJECT_CLAIM=sub
OIDC_JWKS_JSON={"keys":[]}
