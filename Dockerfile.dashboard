FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN useradd --create-home --uid 10001 appuser

COPY pyproject.toml README.md ./
COPY src ./src
COPY app.py ./

RUN pip install --no-cache-dir ".[dashboard]"

USER appuser

EXPOSE 7860

CMD ["python", "app.py"]
